@model IEnumerable<FeedbackManagemant.Models.Feedback>
@{
    ViewBag.Title = "View Feedback";
}

<h3>Feedback List</h3>

<table border="1" cellpadding="8">
    <tr>
        <th>Enrollment No</th>
        <th>Student Name</th>
        <th>Subject</th>
        <th>Rating</th>
        <th>Comments</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.EnrollmentNo</td>
            <td>@item.StudentName</td>
            <td>@item.Subject</td>
            <td>@item.Rating</td>
            <td>@item.Comments</td>
        </tr>
    }
</table>

<br />
@Html.ActionLink("Back to List", "Index")